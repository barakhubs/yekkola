APP_NAME=Yekkola
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local services: `docker compose up -d` from the repo root
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=yekkola
DB_USERNAME=yekkola
DB_PASSWORD=yekkola

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Production: SESSION_SECURE_COOKIE=true and SESSION_DOMAIN=.<parent-domain>
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Front-end apps allowed to use cookie (SPA) auth — same parent domain as the API
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=yekkola-local-master-key

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@yekkola.test"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (Laravel Cloud bucket in staging/production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Integrations — fake/log drivers until real providers are configured.
# Production refuses to boot with fake or log drivers.
VIDEO_DRIVER=fake
PAYMENT_DRIVER=fake
SMS_DRIVER=log
BOT_CHALLENGE_DRIVER=fake
TURNSTILE_SECRET_KEY=
# Required for fake drivers outside local/testing (staging)
FAKE_WEBHOOK_SECRET=
# Local/staging only: a phone number you control, seeded as demo super admin
DEMO_ADMIN_PHONE=

MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
MUX_DRM_CONFIGURATION_ID=
