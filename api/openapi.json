{
    "openapi": "3.1.0",
    "info": {
        "title": "Yekkola",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "paths": {
        "/ping": {
            "get": {
                "operationId": "ping",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me/export": {
            "post": {
                "operationId": "me.export.store",
                "summary": "Request a new export (built in the background). One per day",
                "tags": [
                    "DataExport"
                ],
                "responses": {
                    "202": {
                        "description": "`DataExportResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/DataExportResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "operationId": "me.export.show",
                "summary": "Status of the latest export",
                "tags": [
                    "DataExport"
                ],
                "responses": {
                    "200": {
                        "description": "`DataExportResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/DataExportResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me/export/download": {
            "get": {
                "operationId": "me.export.download",
                "summary": "Download the latest ready export: a short-lived signed link on object storage, streamed otherwise",
                "tags": [
                    "DataExport"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me/devices": {
            "get": {
                "operationId": "me.devices.index",
                "summary": "Registered mobile devices (those that can hold downloads)",
                "tags": [
                    "Device"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `DeviceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/DeviceResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me/devices/{device}": {
            "delete": {
                "operationId": "me.devices.destroy",
                "summary": "Remove a device: it is signed out and its downloads stop being renewed",
                "tags": [
                    "Device"
                ],
                "parameters": [
                    {
                        "name": "device",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "summary": "Sign out of this session (web) or revoke this device's token (mobile). The device stays registered",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/otp/request": {
            "post": {
                "operationId": "auth.otp.request",
                "summary": "Send a sign-in code by SMS. Always answers the same way, whether or not the number has an account",
                "tags": [
                    "Otp"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RequestOtpRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "challenge_id": {
                                                    "type": "string"
                                                },
                                                "expires_at": {
                                                    "type": "string"
                                                },
                                                "resend_after_seconds": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "challenge_id",
                                                "expires_at",
                                                "resend_after_seconds"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/otp/verify": {
            "post": {
                "operationId": "auth.otp.verify",
                "summary": "Verify the code and sign in (creates the account on first sign-in)",
                "tags": [
                    "Otp"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VerifyOtpRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/me/phone/otp": {
            "post": {
                "operationId": "me.phone.otp",
                "summary": "Send a code to the new number. Answers the same whether or not the number is free",
                "tags": [
                    "Phone"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RequestPhoneChangeOtpRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "challenge_id": {
                                                    "type": "string"
                                                },
                                                "expires_at": {
                                                    "type": "string"
                                                },
                                                "resend_after_seconds": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "challenge_id",
                                                "expires_at",
                                                "resend_after_seconds"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/me/phone": {
            "put": {
                "operationId": "me.phone.update",
                "summary": "Confirm the new number. Every other session and device is signed out; the old number is notified",
                "tags": [
                    "Phone"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChangePhoneRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "province"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "me.show",
                "summary": "The signed-in user's account",
                "tags": [
                    "Profile"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "province"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "operationId": "me.update",
                "summary": "Update name, email, language, province, or city",
                "tags": [
                    "Profile"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "province"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "delete": {
                "operationId": "me.destroy",
                "summary": "Request account deletion. Personal data is erased after the grace period unless cancelled",
                "tags": [
                    "Profile"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "province"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me/deletion": {
            "delete": {
                "operationId": "me.deletion.cancel",
                "summary": "Cancel a pending deletion request",
                "tags": [
                    "Profile"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "province"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/provinces": {
            "get": {
                "operationId": "provinces.index",
                "summary": "The 26 DRC provinces, alphabetically",
                "tags": [
                    "Province"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `ProvinceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ProvinceResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ChangePhoneRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "code": {
                        "type": "string"
                    }
                },
                "required": [
                    "phone",
                    "code"
                ],
                "title": "ChangePhoneRequest"
            },
            "DataExportResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "requested_at": {
                        "type": "string"
                    },
                    "ready_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "download_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "status",
                    "requested_at",
                    "ready_at",
                    "expires_at",
                    "download_url"
                ],
                "title": "DataExportResource"
            },
            "DevicePlatform": {
                "type": "string",
                "enum": [
                    "android",
                    "ios"
                ],
                "title": "DevicePlatform"
            },
            "DeviceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "platform": {
                        "type": "string"
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "app_version": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "registered_at": {
                        "type": "string"
                    },
                    "last_active_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "is_current": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "platform",
                    "name",
                    "app_version",
                    "registered_at",
                    "last_active_at",
                    "is_current"
                ],
                "title": "DeviceResource"
            },
            "ProvinceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "code",
                    "name"
                ],
                "title": "ProvinceResource"
            },
            "RequestOtpRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "bot_token": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Cloudflare Turnstile token \u2014 required for web (browser) requests.",
                        "maxLength": 4096
                    }
                },
                "required": [
                    "phone"
                ],
                "title": "RequestOtpRequest"
            },
            "RequestPhoneChangeOtpRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 32
                    }
                },
                "required": [
                    "phone"
                ],
                "title": "RequestPhoneChangeOtpRequest"
            },
            "UpdateProfileRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 100
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "email",
                        "maxLength": 255
                    },
                    "locale": {
                        "type": "string",
                        "enum": [
                            "fr",
                            "en"
                        ]
                    },
                    "province_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    }
                },
                "title": "UpdateProfileRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "locale": {
                        "type": "string"
                    },
                    "province": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ProvinceResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "status": {
                        "type": "string"
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "deletion_requested_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "phone",
                    "name",
                    "email",
                    "email_verified",
                    "locale",
                    "city",
                    "status",
                    "roles",
                    "deletion_requested_at",
                    "created_at"
                ],
                "title": "UserResource"
            },
            "VerifyOtpRequest": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "code": {
                        "type": "string"
                    },
                    "device": {
                        "type": "object",
                        "description": "Mobile apps send their device; web apps sign in with a session instead.",
                        "properties": {
                            "install_id": {
                                "type": "string",
                                "minLength": 8,
                                "maxLength": 64
                            },
                            "platform": {
                                "$ref": "#/components/schemas/DevicePlatform"
                            },
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 100
                            },
                            "app_version": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 32
                            },
                            "push_token": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 4096
                            }
                        }
                    },
                    "replace_device_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "After `device.limit_reached`: the device to sign out to make room."
                    }
                },
                "required": [
                    "phone",
                    "code"
                ],
                "title": "VerifyOtpRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}