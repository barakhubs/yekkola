# API origin (no /api/v1 suffix). Must share the parent domain with this app for Sanctum cookie auth.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this site (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra image origins (object storage), comma-separated. The API origin is always allowed.
NEXT_PUBLIC_IMAGE_HOSTS=
# Server-only. Shared with the API (WEB_SERVER_KEY, WEB_REVALIDATE_SECRET in api/.env): proves server-side
# requests (per-visitor rate limits) and signs cache revalidation calls from the API.
WEB_SERVER_KEY=
WEB_REVALIDATE_SECRET=
# Optional: API origin for server-side calls (private network); defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
