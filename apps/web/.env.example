# API origin (no /api/v1 suffix). Must share the parent domain with this app for Sanctum cookie auth.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this site (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra image origins (object storage), comma-separated. The API origin is always allowed.
NEXT_PUBLIC_IMAGE_HOSTS=
