# API origin (no /api/v1 suffix). Must share the parent domain with this app for Sanctum cookie auth.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Extra image origins for course covers (comma-separated), e.g. the object-storage bucket in staging/production.
NEXT_PUBLIC_IMAGE_HOSTS=

# Cloudflare Turnstile site key for the staff sign-in. Empty locally/staging: the API uses its fake bot-check driver.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
